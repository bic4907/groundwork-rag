# Local models work without credentials. Set PROVIDER=remote for a hosted API.
GENERATION_PROVIDER=ollama
GENERATION_BASE_URL=http://127.0.0.1:11434
GENERATION_MODEL=llama3:latest
GENERATION_API_KEY=
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=nomic-embed-text:latest
EMBEDDING_API_KEY=
# Judge is opt-in. Use an independent model when possible.
JUDGE_PROVIDER=disabled
JUDGE_BASE_URL=
JUDGE_MODEL=
JUDGE_API_KEY=
API_TIMEOUT_SECONDS=180
MAX_CONCURRENT_JOBS=1
# Optional rates per million tokens; blank means unknown, never free.
GENERATION_INPUT_PRICE=
GENERATION_OUTPUT_PRICE=
EMBEDDING_INPUT_PRICE=
JUDGE_INPUT_PRICE=
JUDGE_OUTPUT_PRICE=
# Bind to loopback by default. Use this token when exposing the API.
APP_ACCESS_TOKEN=
